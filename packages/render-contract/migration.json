  "policy": "Rendering implementation is maintained by nova-render. Local extensions are transitional and remain installed until a matching packaged native/Web replacement passes editor regression. Recorded upstream status is a reviewed snapshot, not a live capability probe.",
  "phases": [
    {
      "id": "instances-source-space",
      "upstreamStatus": "in-progress",
      "scope": "多实例、共享资源、独立世界变换、原始尺寸和原点",
      "extensions": ["scene-instances-v1", "source-model-space-v1"]
    },
    {
      "id": "camera-viewport",
      "upstreamStatus": "planned",
      "scope": "完整相机、正交与透视、FOV/裁剪、完整朝向、视口与可选窗口/UI集成",
      "extensions": [
        "camera-poles-v1",
        "orthographic-raster-camera-v1",
        "scene-viewport-rect-v1",
        "parameter-panel-draw-ui-v1",
        "ui-configuration-v1",
        "window-escape-policy-v1"
      ]
    },
    {
      "id": "ray-query",
      "upstreamStatus": "planned",
      "scope": "世界空间射线查询、稳定实例ID、命中位置和距离、过滤与后续加速",
      "extensions": ["scene-picking-v1", "scene-picking-filter-v1"]
    },
    {
      "id": "materials-shadows-atmosphere",
      "upstreamStatus": "planned",
      "scope": "运行时材质槽、场景阴影、雾效及环境加载与清除",
      "extensions": [
        "scene-shadow-map-metal-web-v1",
        "scene-light-settings-v1",
        "scene-raster-fog-v1",
        "environment-clear-v1"
      ]
    }
  ],
