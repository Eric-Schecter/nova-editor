{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nova-editor:scene:6",
  "title": "Nova Editor scene v6 (legacy v1-v5 accepted)",
  "description": "Semantic validators enforce finite transforms, references, one primary camera, up to 16 independent lights, and legacy light exclusivity before v6.",
  "type": "object",
  "required": ["schemaVersion", "name", "nodes", "assets"],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2, 3, 4, 5, 6]
    },
    "name": {
      "type": "string"
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "sourceSpace": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "pattern": "^assets/"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "world": {
      "type": "object",
      "required": ["environment", "background", "fog"],
      "properties": {
        "environment": {
          "type": "object",
          "required": [
            "map",
            "name",
            "rotation",
            "intensity",
            "backgroundIntensity"
          ],
          "properties": {
            "map": {
              "type": ["string", "null"],
              "pattern": "^assets/.+\\.nenv$"
            },
            "name": {
              "type": "string"
            },
            "rotation": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "backgroundIntensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            }
          }
        },
        "background": {
          "type": "object",
          "required": ["mode", "color"],
          "properties": {
            "mode": {
              "enum": ["color", "environment"]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "fog": {
          "type": "object",
          "required": ["mode", "color", "near", "far", "density"],
          "properties": {
            "mode": {
              "enum": ["none", "linear", "exp2"]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "near": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "far": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 2000
            },
            "density": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "parentId", "name", "transform"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "type": ["string", "null"]
        },
        "name": {
          "type": "string"
        },
        "assetId": {
          "type": "string"
        },
        "transform": {
          "type": "object",
          "required": ["position", "rotation", "scale"],
          "properties": {
            "position": {
              "$ref": "#/$defs/vector3"
            },
            "rotation": {
              "$ref": "#/$defs/quaternion"
            },
            "scale": {
              "$ref": "#/$defs/vector3"
            }
          }
        },
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "locked": {
          "type": "boolean",
          "default": false
        },
        "camera": {
          "type": "object",
          "required": [
            "projection",
            "focusDistance",
            "orthographicSize",
            "exposure",
            "primary"
          ],
          "properties": {
            "projection": {
              "enum": ["perspective", "orthographic"]
            },
            "focusDistance": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 100
            },
            "orthographicSize": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 80
            },
            "exposure": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 16
            },
            "primary": {
              "type": "boolean"
            },
            "verticalFov": {
              "type": "number",
              "minimum": 1,
              "maximum": 179
            },
            "nearPlane": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 1000000.0
            },
            "farPlane": {
              "type": "number",
              "minimum": 0.0002,
              "maximum": 10000000.0
            }
          },
          "dependentRequired": {
            "verticalFov": ["nearPlane", "farPlane"],
            "nearPlane": ["verticalFov", "farPlane"],
            "farPlane": ["verticalFov", "nearPlane"]
          }
        },
        "light": {
          "type": "object",
          "required": [
            "type",
            "color",
            "intensity",
            "shadows",
            "softness",
            "active"
          ],
          "properties": {
            "type": {
              "enum": ["directional", "point", "spot"]
            },
            "color": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "shadows": {
              "type": "boolean"
            },
            "softness": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "active": {
              "type": "boolean"
            },
            "range": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000.0
            },
            "innerConeAngle": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1.5707963267948966
            },
            "outerConeAngle": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1.5707963267948966
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": ["point", "spot"]
                  }
                }
              },
              "then": {
                "required": ["range"],
                "properties": {
                  "shadows": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "spot"
                  }
                }
              },
              "then": {
                "required": ["innerConeAngle", "outerConeAngle"]
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["assetId", "camera"]
          }
        },
        {
          "not": {
            "required": ["assetId", "light"]
          }
        },
        {
          "not": {
            "required": ["camera", "light"]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "assets": {
            "additionalProperties": {
              "properties": {
                "sourceSpace": {
                  "const": false
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [1, 2]
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": ["camera"]
                  },
                  {
                    "required": ["light"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [1, 2, 3]
          }
        }
      },
      "then": {
        "not": {
          "required": ["world"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [1, 2, 3, 4]
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "properties": {
                "camera": {
                  "not": {
                    "anyOf": [
                      {
                        "required": ["verticalFov"]
                      },
                      {
                        "required": ["nearPlane"]
                      },
                      {
                        "required": ["farPlane"]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [1, 2, 3, 4, 5]
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "properties": {
                "light": {
                  "properties": {
                    "type": {
                      "const": "directional"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
